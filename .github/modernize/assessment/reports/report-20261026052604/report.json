    {
      "id": "CWE-434",
      "title": "Unrestricted Upload of File with Dangerous Type",
      "category": "File & Path Security",
      "severity": "mandatory",
      "description": "The product allows the upload or transfer of dangerous file types that are automatically processed within its environment.",
      "evidence": {
        "files": [
          "PhotoAlbum/Services/PhotoService.cs:82",
          "PhotoAlbum/Services/PhotoService.cs:109-112",
          "PhotoAlbum/Services/PhotoService.cs:125-138",
          "PhotoAlbum/Services/PhotoService.cs:143-144"
        ],
        "explanation": "PhotoService.UploadPhotoAsync trusts the client-provided ContentType, derives the stored extension from the client-provided FileName, and continues with saving the upload when ImageSharp fails to decode it. An attacker can label arbitrary active content (for example, an HTML file) as an allowed image MIME type and have it stored with an .html extension under wwwroot/uploads, where static-file middleware can serve it."
      },
      "storyPoint": 8
    },
    {
      "id": "CWE-79",
      "title": "Improper Neutralization of Input During Web Page Generation ('Cross-site Scripting')",
      "category": "Injection Attacks",
      "severity": "optional",
      "description": "The product does not neutralize or incorrectly neutralizes user-controllable input before it is placed in output that is used as a web page that is served to other users.",
      "evidence": {
        "files": [
          "PhotoAlbum/wwwroot/js/upload.js:73-75",
          "PhotoAlbum/wwwroot/js/upload.js:128",
          "PhotoAlbum/wwwroot/js/upload.js:223-226"
        ],
        "explanation": "Client-controlled file names are placed into error strings in handleFiles and passed to showErrors, which concatenates them into HTML and assigns that markup to uploadErrors.innerHTML without escaping. An attacker-controlled file name containing markup can therefore execute script in the gallery page when a file is rejected."
      },
      "storyPoint": 8
    }
  ]
