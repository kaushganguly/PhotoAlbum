    {
      "id": "CWE-434",
      "title": "Unrestricted Upload of File with Dangerous Type",
      "category": "File & Path Security",
      "severity": "mandatory",
      "description": "The product allows the upload or transfer of dangerous file types that are automatically processed within its environment.",
      "evidence": {
        "files": [
          "PhotoAlbum/Services/PhotoService.cs:81-88",
          "PhotoAlbum/Services/PhotoService.cs:109-144",
          "PhotoAlbum/Program.cs:62-70"
        ],
        "explanation": "PhotoService.UploadPhotoAsync trusts the supplied Content-Type, retains the client filename extension, and accepts files even when Image.LoadAsync fails. An anonymous uploader can submit HTML with image/png and an .html extension. Original bytes are saved under wwwroot/uploads and served as HTML by static-file middleware, enabling same-origin stored script execution."
      },
      "storyPoint": 8
    },
    {
      "id": "CWE-79",
      "title": "Improper Neutralization of Input During Web Page Generation ('Cross-site Scripting')",
      "category": "Injection Attacks",
      "severity": "optional",
      "description": "The product does not neutralize or incorrectly neutralizes user-controllable input before it is placed in output that is used as a web page that is served to other users.",
      "evidence": {
        "files": [
          "PhotoAlbum/Services/PhotoService.cs:81-144",
          "PhotoAlbum/Program.cs:62-70"
        ],
        "explanation": "PhotoService.UploadPhotoAsync permits HTML bytes with an .html extension when Content-Type is image/png and image decoding fails. Static-file middleware serves these uploaded bytes as active HTML under the application origin. A victim following the public upload URL executes attacker-controlled script. This is the same root cause as CWE-434."
      },
      "storyPoint": 8
    }
  ]
