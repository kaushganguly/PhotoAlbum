    {
      "id": "CWE-772",
      "title": "Missing Release of Resource after Effective Lifetime",
      "category": "Code Quality",
      "severity": "potential",
      "description": "The product does not release a resource after its effective lifetime has ended, i.e., after the resource is no longer needed.",
      "evidence": {
        "files": [
          "PhotoAlbum/Services/PhotoService.cs"
        ],
        "explanation": "PhotoService.UploadPhotoAsync opens an additional stream with file.OpenReadStream() and only sets its Position (line 132); the returned Stream is not assigned to a using scope or disposed after use. Repeated uploads can therefore retain stream resources beyond their effective lifetime."
      },
      "storyPoint": 3
    },
    {
      "id": "CWE-820",
      "title": "Missing Synchronization",
      "category": "Concurrency & Synchronization",
      "severity": "potential",
      "description": "The product utilizes a shared resource in a concurrent manner but does not attempt to synchronize access to the shared resource.",
      "evidence": {
        "files": [
          "PhotoAlbum/Pages/PhotoFile.cshtml.cs:67",
          "PhotoAlbum/Services/PhotoService.cs:224-229"
        ],
        "explanation": "PhotoFileModel.OnGetAsync reads a stored photo while PhotoService.DeletePhotoAsync may delete that same file concurrently. The per-request scoped service does not coordinate these accesses, so concurrent requests can race and make an in-progress photo read fail or observe inconsistent file/database state."
      },
      "storyPoint": 8
    },
    {
      "id": "CWE-434",
      "title": "Unrestricted Upload of File with Dangerous Type",
      "category": "File & Path Security",
      "severity": "mandatory",
      "description": "The product allows the upload or transfer of dangerous file types that are automatically processed within its environment.",
      "evidence": {
        "files": [
          "PhotoAlbum/Services/PhotoService.cs:82",
          "PhotoAlbum/Services/PhotoService.cs:110",
          "PhotoAlbum/Services/PhotoService.cs:127",
          "PhotoAlbum/Services/PhotoService.cs:134"
        ],
        "explanation": "PhotoService.UploadPhotoAsync trusts the client-provided ContentType when checking the allowlist (lines 82-88), then derives the stored extension from the client-provided filename (line 110). ImageSharp decode failures are caught and ignored (lines 125-138), after which the original bytes are still written to the publicly served uploads directory (lines 140-145). A client can therefore label non-image content with an allowed image MIME type and have it stored and served using its supplied extension."
      },
      "storyPoint": 8
    }
  ]
