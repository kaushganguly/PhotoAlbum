    {
      "id": "CWE-772",
      "title": "Missing Release of Resource after Effective Lifetime",
      "category": "Code Quality",
      "severity": "potential",
      "description": "The product does not release a resource after its effective lifetime has ended, i.e., after the resource is no longer needed.",
      "evidence": {
        "files": [
          "PhotoAlbum/Services/PhotoService.cs:127,132"
        ],
        "explanation": "UploadPhotoAsync opens a stream with file.OpenReadStream() and passes it to Image.LoadAsync without retaining or disposing the stream (line 127). It then opens a second stream to set Position and immediately discards the reference (line 132), leaving these stream resources unreleased by the method."
      },
      "storyPoint": 3
    },
    {
      "id": "CWE-259",
      "title": "Use of Hard-coded Password",
      "category": "Credentials & Secrets",
      "severity": "optional",
      "description": "The product contains a hard-coded password, which it uses for its own inbound authentication or for outbound communication to external components.",
      "evidence": {
        "files": [
          "infra/main.json:43"
        ],
        "explanation": "The sqlAdminPassword variable creates the SQL administrator credential as a fixed 'P@ssw0rd' prefix plus ARM uniqueString(resourceGroup().id, environmentName). uniqueString is deterministic from deployment identifiers rather than secret randomness, making the credential reproducible/predictable; the value is passed to the SQL server deployment (infra/main.json:6332)."
      },
      "storyPoint": 5
    },
    {
      "id": "CWE-798",
      "title": "Use of Hard-coded Credentials",
      "category": "Credentials & Secrets",
      "severity": "optional",
      "description": "The product contains hard-coded credentials, such as a password or cryptographic key.",
      "evidence": {
        "files": [
          "infra/main.json:43"
        ],
        "explanation": "The sqlAdminPassword variable creates the SQL administrator credential as a fixed 'P@ssw0rd' prefix plus ARM uniqueString(resourceGroup().id, environmentName). uniqueString is deterministic from deployment identifiers rather than secret randomness, making the credential reproducible/predictable; the value is passed to the SQL server deployment (infra/main.json:6332)."
      },
      "storyPoint": 5
    },
    {
      "id": "CWE-434",
      "title": "Unrestricted Upload of File with Dangerous Type",
      "category": "File & Path Security",
      "severity": "mandatory",
      "description": "The product allows the upload or transfer of dangerous file types that are automatically processed within its environment.",
      "evidence": {
        "files": [
          "PhotoAlbum/Services/PhotoService.cs:82",
          "PhotoAlbum/Services/PhotoService.cs:110-144"
        ],
        "explanation": "UploadPhotoAsync trusts the client-supplied ContentType when checking allowed types (line 82) and derives the stored extension from the client-supplied filename (line 110). If ImageSharp cannot decode the content, the exception is caught and processing continues (lines 125-138), after which the unverified bytes are written to the upload directory (lines 140-144). The server therefore persists content that was not confirmed to be a supported image type."
      },
      "storyPoint": 8
    }
  ]
